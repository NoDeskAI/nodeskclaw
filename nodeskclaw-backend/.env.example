# ── NoDeskClaw 环境变量 ──
#
# 产品部署仅支持 Kubernetes。部署脚本会把本文件写入 K8s Secret。
# 本地开发请使用 dev.sh；仅需本地 PostgreSQL 容器时可使用 dev.sh --docker-pg。

# App
DEBUG=true
# LOG_SQL=true  # 打开后显示 SQLAlchemy SQL 语句（默认关闭，按需开启调试）
# LOG_HEALTH_CHECK=true  # 打印 /health 探针访问日志（默认关闭，错误响应始终打印）
# 版本标识（ce 或 ee）
# K8s 部署: deploy/init.sh 根据 --ee 标志自动设置（覆盖此处手写值），无需手动配置
# 本地开发: 留空则通过 ee/ 目录自动检测
NODESKCLAW_EDITION=

# Database（PostgreSQL）
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/nodeskclaw
# 数据库名后缀（auto = 使用本机 hostname；K8s 部署建议留空）
DATABASE_NAME_SUFFIX=
# DB 连接池（默认值适用于大多数场景）
# DB_POOL_SIZE=10
# DB_POOL_MAX_OVERFLOW=20

# CE 超管（默认 admin，留空则跳过自动创建）
INIT_ADMIN_ACCOUNT=admin
# 设为 true 后重启可强制重置超管密码
RESET_ADMIN_PASSWORD=false

# EE 平台管理员（默认 deskclaw-admin，留空则跳过；与 INIT_ADMIN_ACCOUNT 不能相同）
INIT_EE_ADMIN_ACCOUNT=deskclaw-admin
# 设为 true 后重启可强制重置 EE 管理员密码
RESET_EE_ADMIN_PASSWORD=false

# JWT — 生产环境务必替换
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=24

# KubeConfig 加密密钥（32 字节 base64）
ENCRYPTION_KEY=change-me-32-bytes-base64-key__=

# 飞书 SSO（Admin 应用）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://localhost:4518/login/callback/feishu

# 飞书 SSO（Portal 应用，可选）
FEISHU_APP_ID_PORTAL=
FEISHU_APP_SECRET_PORTAL=

# 云平台
VKE_SUBNET_ID=

# Egress NetworkPolicy（AI 员工 Pod 出站流量控制）
# [已废弃] EGRESS_DENY_CIDRS / EGRESS_ALLOW_PORTS 已迁移至「组织设置 > 网络路由」页面管理。
# 首次升级时，环境变量值会自动迁移到数据库，之后通过 UI 配置。
# 平台服务所在 namespace（NetworkPolicy 允许实例与该 namespace 双向通信）
# 默认自动检测后端 Pod 所在 namespace，通常无需手动设置
# PLATFORM_NAMESPACE=nodeskclaw-system

# Gene Seed（启动时从本地模板导入种子基因，slug 已存在则跳过）
SEED_GENES=true

# DeskHub（远端官方技能库；留空则仅使用本地技能基因库）
DESKHUB_REGISTRY_URL=
DESKHUB_API_KEY=
DESKHUB_WEB_URL=

# LLM Proxy（独立 LLM 代理服务）
# LLM_PROXY_URL 是远端 K8s 实例可达的外部地址
# 本地开发由 dev.sh 自动覆盖为 http://localhost:4511
LLM_PROXY_URL=
# LLM_PROXY_INTERNAL_URL 是平台同集群 K8s 实例使用的内网地址；短 Service 名只适合同 namespace，
# 跨 namespace 建议配置为 <service>.<PLATFORM_NAMESPACE>.svc.cluster.local
LLM_PROXY_INTERNAL_URL=
# LLM_ATTRIBUTION_SECRET 用于签发/验证 LLM 用量归属上下文，需与 LLM Proxy 保持一致
LLM_ATTRIBUTION_SECRET=

# 镜像仓库模式（custom / hosted）
# Custom Registry 通过 Settings 页面配置；Hosted Registry 初次安装由以下变量写入数据库
REGISTRY_MODE=custom
HOSTED_REGISTRY_URL=
HOSTED_REGISTRY_USERNAME=
HOSTED_REGISTRY_PASSWORD=
HOSTED_REGISTRY_TLS_SECRET=
HOSTED_REGISTRY_STORAGE_CLASS=
HOSTED_REGISTRY_STORAGE_SIZE=100Gi
HOSTED_REGISTRY_INGRESS_CLASS=nginx

# K8s 镜像构建访问公网时使用的代理；127.0.0.1 地址会让构建 Pod 使用宿主机网络
IMAGE_BUILD_PROXY_URL=
IMAGE_BUILD_NO_PROXY=127.0.0.1,localhost,.svc,.cluster.local
# Docker Hub 不可达时可替换为兼容镜像代理，例如 registry.example.com/library
IMAGE_BUILD_BASE_IMAGE_REGISTRY=docker.io/library

# S3 兼容对象存储（文件上传功能，不配置则使用本地文件存储）
# 支持 AWS S3、MinIO、阿里云 OSS、火山云 TOS 等任何 S3 兼容服务
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# key 前缀（本地开发可设为 dev，生产留空）
S3_KEY_PREFIX=

# 文件上传策略
# UPLOAD_STORAGE_BACKEND=auto  # auto/local/s3；S3 任一必需项存在但不完整时不会回退 local
# UPLOAD_GATEWAY_PROXY_BODY_SIZE_MB=50
# UPLOAD_PROXY_READ_TIMEOUT_SECONDS=300
# UPLOAD_PROXY_SEND_TIMEOUT_SECONDS=300
# UPLOAD_CHAT_ATTACHMENT_MAX_MB=20
# UPLOAD_CHAT_ATTACHMENT_MAX_COUNT=5
# UPLOAD_CHAT_ATTACHMENT_RETENTION_DAYS=90
# UPLOAD_SHARED_FILE_MAX_MB=200
# UPLOAD_LARGE_FILE_MAX_MB=2048
# UPLOAD_CHUNKED_UPLOAD_THRESHOLD_MB=50
# UPLOAD_CHUNK_SIZE_MB=8
# UPLOAD_WORKSPACE_QUOTA_MB=10240
# UPLOAD_BLOCKED_EXTENSIONS=.exe,.bat,.cmd,.sh
# UPLOAD_ALLOWED_CONTENT_TYPES=
# UPLOAD_SECURITY_SCAN_MODE=metadata_only
# UPLOAD_SCANNER_PROVIDER=none
# UPLOAD_SCANNER_ENDPOINT=
# UPLOAD_SCANNER_TIMEOUT_SECONDS=60
# UPLOAD_SCANNER_MAX_RETRIES=3
# UPLOAD_SCANNER_MAX_FILE_MB=2048
# UPLOAD_SCANNER_FAIL_CLOSED=true

# AI 员工回连后端地址，必须为 K8s Pod 可达的外部地址
# AGENT_API_BASE_URL=https://your-nodeskclaw-domain.com/api/v1
# 发给 Agent 的文件下载稳定地址；为空时使用规范化后的 AGENT_API_BASE_URL
# K8s 部署必须配置为 Agent Pod 可达的后端地址，不能使用浏览器相对路径
# AGENT_FILE_DOWNLOAD_BASE_URL=https://your-nodeskclaw-domain.com/api/v1

# AI 员工 WebSocket 隧道地址（可选，不设则从 AGENT_API_BASE_URL 推导）
# 当 WebSocket 需要走不同入口（如独立的 wss:// 域名）时设置
# TUNNEL_BASE_URL=wss://your-nodeskclaw-domain.com/api/v1/tunnel/connect

# CORS（生产环境改为实际访问域名）
CORS_ORIGINS=["http://localhost:4517","http://localhost:4518"]

# ── 匿名安装遥测（CE-only，帮助项目方统计开源版部署量）──
# 上报内容：匿名 instance UUID、版本、OS、架构、Python 版本；无 PII、无业务数据
# 首次启动成功后只报一次，后续重启不再上报
# 关闭方式任一即可：
#   1) TELEMETRY_ENABLED=false
#   2) POSTHOG_API_KEY 留空
TELEMETRY_ENABLED=true
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=

# 时区（K8s 部署通过 Secret 注入，本地开发也可覆盖）
# TZ=Asia/Shanghai
