{
  "name": "genehub-monorepo",
  "private": true,
  "version": "2026.3.5-1",
  "description": "NoDeskClaw AI 员工基因库",
  "scripts": {
    "dev:registry": "pnpm --filter @nodeskai/genehub-registry dev",
    "dev:web": "pnpm --filter @nodeskai/genehub-web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:generate": "pnpm --filter @nodeskai/genehub-registry db:generate",
    "db:migrate": "pnpm --filter @nodeskai/genehub-registry db:migrate",
    "db:seed": "pnpm --filter @nodeskai/genehub-registry db:seed",
    "genehub": "node packages/cli/dist/index.js",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "release": "node scripts/sync-version.mjs && git add -A && git commit -m \"chore: bump version to $(node scripts/sync-version.mjs --npm-version)\" && git tag $(node scripts/sync-version.mjs --tag) && git push origin master --tags",
    "prepare": "lefthook install || true"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "lefthook": "^2.1.2",
    "tsx": "^4.19"
  }
}
