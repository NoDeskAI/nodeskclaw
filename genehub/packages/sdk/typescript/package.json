{
  "name": "@nodeskai/genehub-sdk",
  "version": "2026.3.5-1",
  "description": "GeneHub TypeScript SDK - API 客户端与产品适配器",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nodeskai/genehub-types": "workspace:*",
    "yaml": "^2.7"
  },
  "devDependencies": {
    "tsup": "^8.3",
    "typescript": "^5.7",
    "vitest": "^3.0",
    "@types/node": "^22.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoDeskAI/genehub.git",
    "directory": "packages/sdk/typescript"
  },
  "homepage": "https://github.com/NoDeskAI/genehub",
  "keywords": [
    "genehub",
    "ai",
    "agent",
    "gene",
    "sdk"
  ],
  "license": "MIT"
}
