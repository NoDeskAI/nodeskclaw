{
  "$schema": "https://opencode.ai/config.json",
  "model": "minimax/MiniMax-M2.5",
  "provider": {
    "minimax": {
      "npm": "@ai-sdk/anthropic",
      "options": {
        "baseURL": "https://api.minimaxi.com/anthropic/v1"
      },
      "env": ["MINIMAX_API_KEY"],
      "models": {
        "MiniMax-M2.5": {
          "name": "MiniMax-M2.5",
          "tool_call": true
        },
        "MiniMax-M2.5-lightning": {
          "name": "MiniMax-M2.5-lightning",
          "tool_call": true
        }
      }
    }
  },
  "mcp": {
    "genehub-prod": {
      "type": "local",
      "command": [
        "kubectl",
        "--kubeconfig", "../../deploy/k8s/kubeconfig-genehub.yaml",
        "exec", "-i",
        "-n", "genehub",
        "deploy/genehub",
        "--",
        "node", "/app/dist/mcp/index.js"
      ],
      "timeout": 30000
    }
  },
  "agent": {}
}
