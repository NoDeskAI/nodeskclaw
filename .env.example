# ── NoDeskClaw 环境变量 ──

# App
DEBUG=true

# Database（火山云 RDS PostgreSQL）
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/nodeskclaw

# JWT — 生产环境务必替换
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=24

# KubeConfig 加密密钥（32 字节 base64）
ENCRYPTION_KEY=change-me-32-bytes-base64-key__=

# 飞书 SSO（Admin 应用）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://localhost:5173/login/callback/feishu

# 飞书 SSO（Portal 应用，可选）
FEISHU_APP_ID_PORTAL=
FEISHU_APP_SECRET_PORTAL=

# 火山云
VKE_SUBNET_ID=
IMAGE_REGISTRY=

# GeneHub Registry（基因注册中心，留空则全部走本地数据库）
GENEHUB_REGISTRY_URL=
GENEHUB_API_KEY=

# CORS
CORS_ORIGINS=["http://localhost:5173"]
